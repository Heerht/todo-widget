<?xml version="1.0" encoding="utf-8"?>
<!--
    AppWidgetProviderInfo：小部件的“身份证”。
    manifest 里的 <meta-data android:name="android.appwidget.provider"> 指向这个文件，
    系统桌面读取它才知道这个部件叫什么、默认多大、多久刷新一次。
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_todo"
    android:maxResizeHeight="440dp"
    android:maxResizeWidth="400dp"
    android:minHeight="110dp"
    android:minResizeHeight="110dp"
    android:minResizeWidth="180dp"
    android:minWidth="250dp"
    android:previewImage="@drawable/widget_preview"
    android:previewLayout="@layout/widget_todo"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
